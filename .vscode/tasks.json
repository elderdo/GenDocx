{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate Default Word Doc",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/gendocx-with-cli.py",
                {
                    "value": "client_name=Test Company & Partners",
                    "quoting": "strong"
                },
                "date=2026-10-14"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}

